# fastlane/Snapfile — iOS App Store screenshot capture.
#
# Drives `AppStoreScreenshotTests` on the listed simulators.
# Output → ./fastlane/screenshots/{language}/*.png (deliver requires flat layout
# in en-US/; nested device subdirectories are silently dropped).
#
# Apple App Store Connect requires screenshots for at minimum one iPhone
# and one iPad slot. The slot expectations are baked into the App Store
# record at App creation time and are sticky — apps created before Apple
# rolled out the M4 13" iPad slot still expect 12.9" 3rd gen+
# (APP_IPAD_PRO_3GEN_129, 2048×2732). Apps created after may also accept
# the M4 13" slot (APP_IPAD_PRO_M4, 2064×2752) but the 12.9" slot is
# universally accepted as a secondary.
#
# The paragraph above is LOW-confidence and unverifiable without an upload, which
# is a write this phase does not make; plan 08-18 owns the first upload and it is
# the measurement. Recorded as still unverifiable rather than planned around.
#
# D-127 — largest per family, native, no upscaling. Each pixel size below is read
# from that device type's OWN profile.plist (mainScreenWidth x mainScreenHeight x
# mainScreenScale) rather than inferred from the device name, and each is on the
# list Apple's spec accepts TODAY — fetched 2026-09-11, quoted in
# .planning/phases/08-submission-artifacts-store-metadata/evidence/08-13-ios-screenshots.txt
devices([
  "iPhone 16 Pro Max",                           # 6.9" — APP_IPHONE_67 (1320×2868)
  "iPad Pro 13-inch (M4)"                        # 13" — APP_IPAD_PRO_3GEN_129 (2064×2752)
])

# Pin the runtime rather than taking whatever `snapshot` resolves last. 18.6 is
# the ONLY installed runtime carrying BOTH devices (iPhone 16 Pro Max: 18.6 only;
# iPad Pro 13-inch M4: 17.5 and 18.6) — measured, not assumed. Note the pin is a
# PREFERENCE inside fastlane, not a constraint: `find_device` falls back to the
# newest name match and only prints "Using device named ... because no match was
# found", so the runtime the run ACTUALLY used is read back out of the run log.
ios_version("18.6")

languages(["en-US"])

project("app/App.xcodeproj")
scheme("App-iOS")
configuration("Debug")

output_directory("./fastlane/screenshots")

clear_previous_screenshots(true)

# Serial — concurrent simulators race when shared state is involved.
concurrent_simulators(false)

# Pin the simulator status bar to a clean 9:41 / full battery / full
# wifi state for App Store screenshots. Apple-recommended convention;
# also used by their official marketing assets. Without this the status
# bar shows whatever the simulator was on (battery low, no carrier, etc.)
# which looks unprofessional in App Store screenshots.
override_status_bar(true)
